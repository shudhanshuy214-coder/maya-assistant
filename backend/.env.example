# ============================================================
# MAYA V1 — Backend environment variables  (SERVER SIDE ONLY)
# ------------------------------------------------------------
# 1. Copy this file:            cp .env.example .env
# 2. Edit .env and put YOUR OWN real key after OPENAI_API_KEY=
# 3. NEVER commit .env to git (it is already in .gitignore)
# 4. NEVER put the key in the frontend, HTML, JS or APK code.
#    The browser only receives Maya's reply — never your key.
# ============================================================

OPENAI_API_KEY=

# AI model used by Maya (you may change it: gpt-4o-mini, gpt-4o, etc.)
OPENAI_MODEL=gpt-4o-mini

# Port the backend listens on
PORT=3000

# For development leave as * ; for production set to your site, e.g. https://your-domain.com
ALLOWED_ORIGIN=*
